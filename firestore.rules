rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 100 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // SPMB Pendaftaran Murid Baru
    match /spmb_registrations/{regId} {
      allow read, write: if isValidId(regId);
    }

    // Data Akun Pengguna
    match /registered_users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Koleksi umum aplikasi SIBOGO
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
