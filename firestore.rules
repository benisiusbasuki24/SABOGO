rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // SPMB Pendaftaran Murid Baru
    match /spmb_registrations/{regId} {
      allow read, write: if true;
    }

    // Data Akun Pengguna SIBOGO (Login & Register)
    match /registered_users/{userId} {
      allow read, write: if true;
    }

    // Data Siswa
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Data Tagihan Biaya Sekolah
    match /bills/{billId} {
      allow read, write: if true;
    }

    // Data Transaksi Kasir & Kuitansi
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // Data Penggajian Guru & Staf
    match /payrolls/{payrollId} {
      allow read, write: if true;
    }

    // Data Inventarisasi Sarana & Prasarana
    match /inventory_assets/{assetId} {
      allow read, write: if true;
    }

    // Data Administrasi Mengajar Guru
    match /teaching_docs/{docId} {
      allow read, write: if true;
    }

    // Data Master Guru & Staf
    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    // Data Master Pos Tarif Tagihan
    match /bill_types/{typeId} {
      allow read, write: if true;
    }

    // Konfigurasi Sistem & Profil Sekolah
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // Koleksi umum aplikasi SIBOGO
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
